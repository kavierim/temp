<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Motion Magnifier - Live Webcam Amplification</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            background-color: #f8fafc;
            color: #1e293b;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
        }
        .canvas-container {
            position: relative;
            width: 100%;
            max-width: 800px;
            aspect-ratio: 4/3;
            background: #ffffff;
            border-radius: 1.5rem;
            overflow: hidden;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
            border: 1px solid #e2e8f0;
        }
        canvas {
            width: 100%;
            height: 100%;
            display: block;
        }
        .controls-panel {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(226, 232, 240, 0.8);
        }
        input[type="range"] {
            accent-color: #2563eb;
        }
        /* Active button state */
        .mode-btn.active {
            border-color: #2563eb !important;
            background-color: #eff6ff !important;
            color: #1d4ed8 !important;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col items-center p-4 md:p-8">

    <header class="text-center mb-10">
        <h1 class="text-4xl font-extrabold mb-3 tracking-tight text-slate-900">
            Motion <span class="text-blue-600">Magnifier</span>
        </h1>
        <p class="text-slate-500 max-w-md mx-auto text-lg">
            Reveal invisible vibrations and subtle movements from your webcam in real-time.
        </p>
    </header>

    <div class="canvas-container group mb-10">
        <canvas id="mainCanvas"></canvas>
        <div id="statusOverlay" class="absolute inset-0 flex flex-col items-center justify-center bg-white/90 transition-opacity duration-500">
            <div class="p-4 rounded-full bg-blue-50 mb-6">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
            </div>
            <button id="startButton" class="px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-2xl font-bold shadow-xl shadow-blue-200 transition-all active:scale-95 transform">
                Access Camera
            </button>
            <p class="mt-4 text-sm text-slate-400">Requires camera permissions to function locally.</p>
        </div>
    </div>

    <div class="controls-panel w-full max-w-2xl rounded-3xl p-8 grid grid-cols-1 md:grid-cols-2 gap-10 shadow-sm">
        <!-- Gain Control -->
        <div class="space-y-4">
            <div class="flex justify-between items-center">
                <label class="text-sm font-bold text-slate-700 uppercase tracking-wider">Amplification</label>
                <span id="gainVal" class="px-2 py-1 bg-blue-100 text-blue-700 rounded-lg font-mono text-sm font-bold">15x</span>
            </div>
            <input type="range" id="gainInput" min="1" max="100" value="15" class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer">
            <p class="text-xs text-slate-400">Boosts the magnitude of detected changes.</p>
        </div>

        <!-- Smoothing Control -->
        <div class="space-y-4">
            <div class="flex justify-between items-center">
                <label class="text-sm font-bold text-slate-700 uppercase tracking-wider">Smoothing</label>
                <span id="smoothVal" class="px-2 py-1 bg-emerald-100 text-emerald-700 rounded-lg font-mono text-sm font-bold">0.85</span>
            </div>
            <input type="range" id="smoothInput" min="0" max="99" value="85" class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer">
            <p class="text-xs text-slate-400">Reduces noise by averaging frames over time.</p>
        </div>

        <!-- Mode Select -->
        <div class="space-y-4 md:col-span-2">
            <label class="text-sm font-bold text-slate-700 uppercase tracking-wider">Viewing Mode</label>
            <div class="flex p-1.5 bg-slate-100/50 rounded-2xl gap-1">
                <button data-mode="normal" class="mode-btn flex-1 py-3 rounded-xl text-sm font-semibold transition-all border-2 border-transparent text-slate-500 hover:text-slate-700">Original</button>
                <button data-mode="amplified" class="mode-btn flex-1 py-3 rounded-xl text-sm font-semibold transition-all border-2 border-transparent text-slate-500 hover:text-slate-700 active">Amplified</button>
                <button data-mode="motion" class="mode-btn flex-1 py-3 rounded-xl text-sm font-semibold transition-all border-2 border-transparent text-slate-500 hover:text-slate-700">Motion Ghost</button>
            </div>
        </div>
    </div>

    <footer class="mt-12 text-slate-400 text-sm text-center">
        <p>Pro Tip: For best results, place your laptop or camera on a solid, unmoving table.</p>
    </footer>

    <video id="videoElement" class="hidden" autoplay playsinline></video>
    <canvas id="bufferCanvas" class="hidden"></canvas>

    <script>
        const video = document.getElementById('videoElement');
        const mainCanvas = document.getElementById('mainCanvas');
        const bufferCanvas = document.getElementById('bufferCanvas');
        const startButton = document.getElementById('startButton');
        const statusOverlay = document.getElementById('statusOverlay');
        
        const gainInput = document.getElementById('gainInput');
        const gainVal = document.getElementById('gainVal');
        const smoothInput = document.getElementById('smoothInput');
        const smoothVal = document.getElementById('smoothVal');
        const modeBtns = document.querySelectorAll('.mode-btn');

        const ctx = mainCanvas.getContext('2d', { alpha: false });
        const bCtx = bufferCanvas.getContext('2d', { alpha: false });

        let stream = null;
        let averageFrame = null; 
        let animationId = null;
        let currentMode = 'amplified';

        let gain = 15;
        let smoothing = 0.85;

        async function startCamera() {
            try {
                stream = await navigator.mediaDevices.getUserMedia({ 
                    video: { 
                        width: { ideal: 640 }, 
                        height: { ideal: 480 },
                        frameRate: { ideal: 30 } 
                    } 
                });
                video.srcObject = stream;
                
                video.onloadedmetadata = () => {
                    mainCanvas.width = video.videoWidth;
                    mainCanvas.height = video.videoHeight;
                    bufferCanvas.width = video.videoWidth;
                    bufferCanvas.height = video.videoHeight;
                    
                    statusOverlay.classList.add('opacity-0');
                    setTimeout(() => statusOverlay.style.display = 'none', 500);
                    
                    if (animationId) cancelAnimationFrame(animationId);
                    requestAnimationFrame(processFrame);
                };
            } catch (err) {
                const errorBox = document.createElement('div');
                errorBox.className = "fixed top-8 left-1/2 -translate-x-1/2 bg-white text-red-600 px-6 py-4 rounded-2xl shadow-2xl border border-red-100 z-50 font-bold flex items-center gap-3";
                errorBox.innerHTML = `
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                    <span>Camera access denied. Please enable and refresh.</span>
                `;
                document.body.appendChild(errorBox);
            }
        }

        function processFrame() {
            if (!stream || video.paused || video.ended) return;

            bCtx.drawImage(video, 0, 0, bufferCanvas.width, bufferCanvas.height);
            const currentImageData = bCtx.getImageData(0, 0, bufferCanvas.width, bufferCanvas.height);
            const data = currentImageData.data;
            const len = data.length;

            if (!averageFrame) {
                averageFrame = new Float32Array(len);
                for (let i = 0; i < len; i++) averageFrame[i] = data[i];
            }

            if (currentMode === 'normal') {
                ctx.putImageData(currentImageData, 0, 0);
                for (let i = 0; i < len; i++) {
                    averageFrame[i] = averageFrame[i] * smoothing + data[i] * (1 - smoothing);
                }
            } else {
                const outputImageData = ctx.createImageData(bufferCanvas.width, bufferCanvas.height);
                const outData = outputImageData.data;

                for (let i = 0; i < len; i += 4) {
                    for (let j = 0; j < 3; j++) {
                        const idx = i + j;
                        averageFrame[idx] = averageFrame[idx] * smoothing + data[idx] * (1 - smoothing);
                        let diff = data[idx] - averageFrame[idx];
                        
                        if (currentMode === 'amplified') {
                            let val = data[idx] + (diff * gain);
                            outData[idx] = Math.min(255, Math.max(0, val));
                        } else if (currentMode === 'motion') {
                            let val = 128 + (diff * gain);
                            outData[idx] = Math.min(255, Math.max(0, val));
                        }
                    }
                    outData[i + 3] = 255;
                }
                ctx.putImageData(outputImageData, 0, 0);
            }

            animationId = requestAnimationFrame(processFrame);
        }

        // Listeners
        startButton.addEventListener('click', startCamera);
        gainInput.addEventListener('input', (e) => {
            gain = parseInt(e.target.value);
            gainVal.textContent = gain + 'x';
        });
        smoothInput.addEventListener('input', (e) => {
            smoothing = parseInt(e.target.value) / 100;
            smoothVal.textContent = smoothing.toFixed(2);
        });

        modeBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                modeBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                currentMode = btn.dataset.mode;
            });
        });

    </script>
</body>
</html>
